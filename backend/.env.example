# LyricSpot backend — copy to backend/.env. Everything is optional.

# Spotify Web API: exact track links + popularity signal.
# https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Musixmatch: lyrics -> song search. https://developer.musixmatch.com/
MUSIXMATCH_API_KEY=

# Genius client access token: official lyric search. https://genius.com/api-clients
GENIUS_API_TOKEN=

# Humming support (query by melody) via ACRCloud. Create an "Audio & Video
# Recognition" project with the humming bucket: https://www.acrcloud.com/
# Without these, hummed clips get an honest "sing the words" message.
ACRCLOUD_HOST=
ACRCLOUD_ACCESS_KEY=
ACRCLOUD_ACCESS_SECRET=

# Whisper model: tiny, base, small, medium, large (bigger = slower, more accurate).
WHISPER_MODEL=base
# Set to 0 to skip loading Whisper at startup (loads on first upload instead).
WHISPER_PRELOAD=1

# Allowed browser origins (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://shashwat1729.github.io

# Tuning (defaults shown).
# TRANSCRIPTION_MIN_CONFIDENCE=0.35
# CONFIDENCE_HIGH_THRESHOLD=70
# CONFIDENCE_HIGH_MARGIN=10
# IDENTIFY_TIMEOUT=45

# AudD song recognition (paid, optional).
AUDD_API_TOKEN=
