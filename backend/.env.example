# ContinueMySong AI - Environment Variables
# Copy this file to .env and fill in your credentials

# Spotify Web API (required for direct track links)
# Get from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFY_CLIENT_SECRET=your_client_secret_here

# AudD Music Recognition API (optional, paid — $5/month for 1000 requests)
# Only needed if you want additional search accuracy. Skip for hackathon.
# Get from: https://dashboard.audd.io/
AUDD_API_TOKEN=

# Musixmatch API (optional, 14M+ songs in 80+ languages)
# A community key is used by default. Get your own for higher limits:
# https://developer.musixmatch.com/
MUSIXMATCH_API_KEY=

# Genius client access token (optional, free read-only lyric search).
# Without it the backend uses the keyless webpage endpoint. Get it at
# https://genius.com/api-clients -> your app -> Generate Access Token.
GENIUS_API_TOKEN=

# Whisper model size: tiny, base, small, medium, large
# Smaller = faster but less accurate. "base" is recommended for demos.
WHISPER_MODEL=base

# CORS origins (comma-separated). Set to your deployed frontend URL for production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Server settings
HOST=0.0.0.0
PORT=8000
